# Nexconn (Console → App Key page). Choose the Singapore data centre.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXT_PUBLIC_NEXCONN_APP_KEY=
# NEXCONN_API_BASE=https://api.sg-light-api.com
# NEXCONN_API_BACKUP=https://api-b.sg-light-api.com
# Supabase (Project settings → API). Service key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Google AI Studio key (optional; fallback proposals without it)
GEMINI_API_KEY=
# Any random 32+ char string
SESSION_SECRET=
